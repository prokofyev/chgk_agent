# Подключение к PostgreSQL с расширением pgvector
CHGK_DATABASE__DSN=postgresql+asyncpg://postgresql@localhost:5432/chgk_agent
# База для интеграционных тестов; по умолчанию — рабочая база с суффиксом _test
# CHGK_DATABASE__TEST_DSN=postgresql+asyncpg://postgresql@localhost:5432/chgk_agent_test

# GigaChat
CHGK_GIGACHAT__CREDENTIALS=
CHGK_GIGACHAT__SCOPE=GIGACHAT_API_PERS
CHGK_GIGACHAT__MODEL=GigaChat
CHGK_GIGACHAT__EMBEDDING_MODEL=Embeddings
CHGK_GIGACHAT__EMBEDDING_DIM=1024
CHGK_GIGACHAT__VERIFY_SSL=true

# Внешний источник вопросов
CHGK_EXTERNAL__ENABLED=true
CHGK_EXTERNAL__BASE_URL=https://gotquestions.online
CHGK_EXTERNAL__USER_AGENT=chgk-agent/0.1 (+https://localhost/chgk-agent)
CHGK_EXTERNAL__MAX_QUERY_CHARS=50
CHGK_EXTERNAL__MAX_QUERY_TERMS=3
CHGK_EXTERNAL__MIN_INTERVAL_SECONDS=1.0
CHGK_EXTERNAL__TIMEOUT_SECONDS=15

# Поиск
CHGK_SEARCH__TOP_K=20
CHGK_SEARCH__MIN_SCORE=0.85
CHGK_SEARCH__GENERATE_ANSWER=true
CHGK_SEARCH__LEXICAL_WEIGHT=0.15
CHGK_SEARCH__LEXICAL_SATURATION=10.0
CHGK_SEARCH__CORPUS_INDEX_TIMEOUT_SECONDS=2.0

# Наблюдаемость
CHGK_OBSERVABILITY__LOG_LEVEL=INFO
CHGK_OBSERVABILITY__JSON_LOGS=false
